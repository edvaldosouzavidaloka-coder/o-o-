<?xml version='1.0' encoding='UTF-8' standalone='no'?>
<sounds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/vehicle_sounds.xsd">
    <motorized>
        <sounds>
            <motor template="indoorCabinRumble"/>
            <motorStart file="sounds/start.ogg" volumeScale="1.0" innerRadius="5" outerRadius="80"/>
            <motorStop file="sounds/stop.ogg" volumeScale="1.0" innerRadius="5" outerRadius="80"/>
            <motor file="sounds/idle.ogg" volumeScale="1.0" innerRadius="5" outerRadius="80"><volume indoor="0.7" outdoor="1.0"><modifier type="JD8R_RPM" value="0" modifiedValue="1"/><modifier type="JD8R_RPM" value="0.25" modifiedValue="0.85"/><modifier type="JD8R_RPM" value="0.6" modifiedValue="0.15"/><modifier type="JD8R_RPM" value="1" modifiedValue="0.05"/></volume><pitch indoor="0.95" outdoor="0.95"><modifier type="JD8R_RPM" value="0" modifiedValue="0.92"/><modifier type="JD8R_RPM" value="1" modifiedValue="1.25"/></pitch></motor>
            <motor file="sounds/load.ogg" volumeScale="1.0" innerRadius="5" outerRadius="80"><volume indoor="0.7" outdoor="1.0"><modifier type="JD8R_RPM" value="0" modifiedValue="0.05"/><modifier type="JD8R_RPM" value="0.25" modifiedValue="0.35"/><modifier type="JD8R_RPM" value="0.6" modifiedValue="0.75"/><modifier type="JD8R_RPM" value="1" modifiedValue="1"/><modifier type="JD8R_LOAD" value="0" modifiedValue="0.9"/><modifier type="JD8R_LOAD" value="0.5" modifiedValue="0.45"/><modifier type="JD8R_LOAD" value="1" modifiedValue="0.25"/></volume><pitch indoor="1" outdoor="1"><modifier type="JD8R_RPM" value="0" modifiedValue="0.75"/><modifier type="JD8R_RPM" value="1" modifiedValue="1.15"/></pitch></motor>
            <motor file="sounds/run.ogg" volumeScale="1.0" innerRadius="5" outerRadius="80"><volume indoor="0.7" outdoor="1.0"><modifier type="JD8R_RPM" value="0" modifiedValue="0"/><modifier type="JD8R_RPM" value="0.2" modifiedValue="0.4"/><modifier type="JD8R_RPM" value="1" modifiedValue="1"/><modifier type="JD8R_LOAD" value="0" modifiedValue="0"/><modifier type="JD8R_LOAD" value="0.3" modifiedValue="0.3"/><modifier type="JD8R_LOAD" value="1" modifiedValue="0.9"/></volume><pitch indoor="1" outdoor="1"><modifier type="JD8R_RPM" value="0" modifiedValue="0.75"/><modifier type="JD8R_RPM" value="1" modifiedValue="1.15"/></pitch></motor>
            <gearbox file="$data/sounds/vehicles/transmission/newHollandTransmission.mp3" pitchScale="0.6" volumeScale="0.45" innerRadius="7.0" outerRadius="60.0">
                <volume indoor="0.65" outdoor="1.5">
                    <modifier type="SPEED" value="4.0" modifiedValue="0.0"/>
                    <modifier type="SPEED" value="30.0" modifiedValue="1.0"/>
                    <modifier type="SPEED" value="60.0" modifiedValue="1.0"/>
                    <modifier type="SPEED" value="120.0" modifiedValue="1.4"/>

                    <modifier type="MOTOR_LOAD" value="-1.00" modifiedValue="1.0"/>
                    <modifier type="MOTOR_LOAD" value="0.00" modifiedValue="1.0"/>
                    <modifier type="MOTOR_LOAD" value="0.20" modifiedValue="1.0"/>
                    <modifier type="MOTOR_LOAD" value="0.45" modifiedValue="2.0"/>
                    <modifier type="MOTOR_LOAD" value="0.80" modifiedValue="1.0"/>
                    <modifier type="MOTOR_LOAD" value="1.00" modifiedValue="0.7"/>

                    <modifier type="DRIVING_DIRECTION" value="-1.0" modifiedValue="1.5"/>
                    <modifier type="DRIVING_DIRECTION" value="0.00" modifiedValue="0.0"/>
                    <modifier type="DRIVING_DIRECTION" value="1.00" modifiedValue="1.0"/>
                </volume>
                <pitch indoor="1.80" outdoor="1.77">
                    <modifier type="SPEED" value="0.0" modifiedValue="0.3"/>
                    <modifier type="SPEED" value="60.0" modifiedValue="0.8"/>
                    <modifier type="SPEED" value="120.0" modifiedValue="1.3"/>

                    <modifier type="SUSPENSION" value="-1.0" modifiedValue="0.9"/>
                    <modifier type="SUSPENSION" value="-0.5" modifiedValue="0.95"/>
                    <modifier type="SUSPENSION" value="0.0" modifiedValue="1.0"/>
                    <modifier type="SUSPENSION" value="0.5" modifiedValue="1.05"/>
                    <modifier type="SUSPENSION" value="1.0" modifiedValue="1.1"/>

                    <modifier type="DRIVING_DIRECTION" value="-1.0" modifiedValue="1.8"/>
                    <modifier type="DRIVING_DIRECTION" value="0.00" modifiedValue="1.0"/>
                    <modifier type="DRIVING_DIRECTION" value="1.00" modifiedValue="1.0"/>
                </pitch>

                <lowpassGain indoor="0.3" outdoor="1.0"/>
                <lowpassCutoffFrequency indoor="700" outdoor="20000.0"/>
                <lowpassResonance indoor="1.0" outdoor="1.0"/>
            </gearbox>
            <compressedAir template="compressedAir"/>
            <gearLeverStart template="gearDisengaged"/>
            <gearLeverEnd template="gearEngaged"/>

        </sounds>
    </motorized>

    <lights>
        <sounds>
            <toggleLights file="sounds/generated/switch.ogg" volumeScale="0.6" innerRadius="5" outerRadius="65" fadeIn="0.01" fadeOut="0.05"/>
            <turnLight file="sounds/generated/turn.ogg" volumeScale="0.7" innerRadius="5" outerRadius="65" fadeIn="0.01" fadeOut="0.05"/>
        </sounds>
    </lights>

    <attacherJoints>
        <sounds>
            <attach linkNode="0&gt;" file="sounds/generated/attach.ogg" volumeScale="0.7" innerRadius="5" outerRadius="65" fadeIn="0.01" fadeOut="0.05"/>
            <hydraulic linkNode="0&gt;" file="sounds/generated/hydraulic.ogg" volumeScale="0.6" innerRadius="5" outerRadius="65" fadeIn="0.01" fadeOut="0.05"/>
        </sounds>
    </attacherJoints>

    <drivable>
        <sounds>
            <waterSplash file="sounds/generated/water.ogg" volumeScale="0.7" innerRadius="5" outerRadius="65" fadeIn="0.01" fadeOut="0.05"/>
        </sounds>
    </drivable>

    <honk>
        <sound linkNode="0&gt;" file="sounds/generated/horn.ogg" volumeScale="1.0" innerRadius="5" outerRadius="65" fadeIn="0.01" fadeOut="0.05"/>
    </honk>
</sounds>
